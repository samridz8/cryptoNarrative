# Narrative Radar — Configuration
# Copy this to .env and adjust as needed

# How often to collect data (minutes)
COLLECTION_INTERVAL_MINUTES=15

# How many top coins to fetch from CoinGecko markets endpoint
TOP_MARKETS_COUNT=200

# Dashboard port
PORT=8000

# ── Quality Filters ────────────────────────────────────────────
# Tokens not meeting these thresholds are discarded before scoring

# Minimum liquidity in USD (only applied to DEX tokens where data is available)
MIN_LIQUIDITY_USD=100000

# Minimum market cap in USD
MIN_MARKET_CAP=1000000

# Minimum 24h volume in USD
MIN_VOLUME_24H=50000

# Maximum absolute 24h price change % before a token is flagged suspicious
MAX_PRICE_CHANGE_ABS=500

# ── Alerts ────────────────────────────────────────────────────
# Minimum confidence score to fire an alert (0-100)
ALERT_CONFIDENCE_THRESHOLD=60
